# Odoo (the same Odoo HQ uses). Create the API key in Odoo: your user → Account Security → New API key.
ODOO_URL=https://your-company.odoo.com
ODOO_DB=parableventures
ODOO_USERNAME=api-user@example.com
ODOO_API_KEY=
# Any long random string; signs the sign-in cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Added automatically when you connect a Neon Postgres database under Vercel → Storage.
DATABASE_URL=
